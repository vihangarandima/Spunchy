# Copy to .env.local and fill in. Never commit .env.local.

# Public site URL once the domain is confirmed (enables canonical + sitemap.xml)
SITE_URL=

# Supabase — leave empty to run on local demo data (mock mode).
# The anon key is safe in the browser ONLY because Row Level Security is on
# (see supabase/schema.sql). Never put the service_role key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
